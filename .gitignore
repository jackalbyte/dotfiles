# exclude tmux plugins
.config/tmux/plugins/

# local fish configuration
fish/.config/fish/config_local.fish

# zed llm prompts
zed/.config/zed/prompts/

# herdr runtime state and logs
herdr/.config/herdr/*.log
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/*.sock*
herdr/.config/herdr/session.json
herdr/.config/herdr/session-snapshots/

# herdr-app generated files inside mods
herdr-app/.config/herdr-app/mods/*/gpui-kit.d.ts
herdr-app/.config/herdr-app/mods/*/jsconfig.json
